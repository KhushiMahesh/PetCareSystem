@page "/owner/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PetOwner")]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PetCareSystem.Web.Data
@using PetCareSystem.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<OwnerDashboard> Logger

<PageTitle>Pet Owner Dashboard | Pawberry Animal Hospital</PageTitle>

<div class="pawberry-owner-dashboard">

    @if (IsLoading)
    {
        <div class="text-center py-5"><h4>🐾 Loading your dashboard...</h4></div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else if (Owner == null)
    {
        <div class="alert alert-warning">Your owner profile could not be found.</div>
    }
    else
    {
        <section class="pawberry-hero">
            <div class="pawberry-hero-text">
                <span class="pawberry-welcome-label">YOUR PAWBERRY HOME 🐾</span>
                <h1>Welcome back,<br />@Owner.FullName! 💙</h1>
                <p>Your pet's health, our priority!</p>
            </div>
            <div class="pawberry-hero-art">
                <span class="hero-heart heart-one">♥</span>
                <span class="hero-heart heart-two">♥</span>
                <span class="hero-paw paw-one">🐾</span>
                <div class="hero-pet hero-dog">🐶</div>
                <div class="hero-pet hero-cat">🐱</div>
                <span class="hero-heart heart-three">♥</span>
            </div>
        </section>

        <section class="pawberry-quick-actions">
            <a href="/owner/pets" class="pawberry-action action-pink">
                <span class="action-icon">🐾</span>
                <span><strong>View My Pets</strong><small>Manage your furry friends</small></span>
                <b>›</b>
            </a>
            <a href="/owner/appointments" class="pawberry-action action-blue">
                <span class="action-icon">📅</span>
                <span><strong>Book Appointment</strong><small>Schedule a visit</small></span>
                <b>›</b>
            </a>
            <a href="/owner/medical-records" class="pawberry-action action-purple">
                <span class="action-icon">🩺</span>
                <span><strong>View Records</strong><small>Check medical history</small></span>
                <b>›</b>
            </a>
            <a href="/owner/invoices" class="pawberry-action action-mint">
                <span class="action-icon">💳</span>
                <span><strong>View Billing</strong><small>See your invoices</small></span>
                <b>›</b>
            </a>
        </section>

        <section class="pawberry-main-grid">
            <div class="pawberry-box pawberry-pets-box">
                <div class="pawberry-box-heading">
                    <h3>🐾 My Little Paws</h3>
                    <a href="/owner/pets">View All →</a>
                </div>

                @if (OwnerPets.Any())
                {
                    <div class="pawberry-pet-list">
                        @foreach (var pet in OwnerPets)
                        {
                            <a href="/owner/pets" class="pawberry-pet-item" @key="pet.PetId">
                                <div class="pawberry-pet-avatar">🐾</div>
                                <strong>@pet.PetName</strong>
                                <small>@pet.Species?.SpeciesName</small>
                                <span>♥</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="pawberry-empty-pets">
                        <span>🐶</span>
                        <p>No pets registered yet!</p>
                        <a href="/owner/pets">Add your first pet →</a>
                    </div>
                }

                <div class="pawberry-pet-count">
                    🐾 You have <strong>@PetCount</strong> lovely pet(s) registered! 💗
                </div>
            </div>

            <div class="pawberry-box pawberry-care-box">
                <h3>Pet Care Tip 💡</h3>
                <p>Keep your pets hydrated and provide a balanced diet!</p>
                <div class="pawberry-care-art">
                    <span>🥣</span><span>🧶</span><span>🐱</span>
                </div>
                <div class="pawberry-care-footer">Healthy Pets. Happy Hearts. 💙</div>
            </div>

            <div class="pawberry-box pawberry-account-box">
                <h3>👤 Account Information</h3>
                <hr />
                <p><strong>Name</strong><br />@Owner.FullName</p>
                <p><strong>Email</strong><br />@OwnerEmail</p>
                <a href="/Account/Manage" class="pawberry-account-link">Manage Account →</a>
                <span class="account-decoration">🐾</span>
            </div>
        </section>

        <section class="pawberry-bottom-actions">
            <a href="/owner/emergency-cases" class="pawberry-bottom-card">
                <span>🚑</span><div><strong>Emergency History</strong><small>Track emergency visits</small></div><b>›</b>
            </a>
            </section>

        <footer class="pawberry-dashboard-footer">
            <span>🐾</span> Healthy Pets. Happy Hearts. 💙 <span>🐾</span>
        </footer>
    }

</div>
@code {
    private OwnerProfile? Owner;
    private string OwnerEmail = string.Empty;
    private int PetCount;
    private List<Pet> OwnerPets = new();
    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = await UserManager.GetUserAsync(authState.User);

            if (user == null)
            {
                ErrorMessage = "Your login session could not be verified. Please log in again.";
                return;
            }

            OwnerEmail = user.Email ?? string.Empty;

            Owner = await DbContext.OwnerProfiles
                .FirstOrDefaultAsync(o => o.UserId == user.Id);

            if (Owner == null)
            {
                ErrorMessage = "Your Pet Owner profile was not found in the database.";
                return;
            }

            PetCount = await DbContext.Pets
                .CountAsync(p => p.OwnerProfileId == Owner.OwnerProfileId);

            OwnerPets = await DbContext.Pets.Include(p => p.Species).Include(p => p.Breed).Where(p => p.OwnerProfileId == Owner.OwnerProfileId).OrderBy(p => p.PetName).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Pet Owner dashboard.");

            ErrorMessage = "Something went wrong while loading your dashboard. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
