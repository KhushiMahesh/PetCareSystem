
@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Linq
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PetCareSystem.Web.Data
@using PetCareSystem.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ApplicationDbContext DbContext
@inject ILogger<Register> Logger
@inject NavigationManager Navigation

<PageTitle>Register | PetCareSystem</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="text-center mb-2">Create Account</h2>

                    <p class="text-center text-muted mb-4">
                        Join PetCareSystem and manage your pet's healthcare.
                    </p>

                    <EditForm Model="@Input"
                              OnValidSubmit="@RegisterUser"
                              FormName="register">

                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                        {
                            <div class="alert alert-danger">
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>

                            <InputText class="form-control"
                                       @bind-Value="Input.FullName"
                                       placeholder="Enter your full name" />

                            <ValidationMessage For="@(() => Input.FullName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>

                            <InputText class="form-control"
                                       @bind-Value="Input.Email"
                                       type="email"
                                       placeholder="Enter your email" />

                            <ValidationMessage For="@(() => Input.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>

                            <InputText class="form-control"
                                       @bind-Value="Input.Password"
                                       type="password"
                                       placeholder="Create a password" />

                            <ValidationMessage For="@(() => Input.Password)" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Confirm Password</label>

                            <InputText class="form-control"
                                       @bind-Value="Input.ConfirmPassword"
                                       type="password"
                                       placeholder="Confirm your password" />

                            <ValidationMessage For="@(() => Input.ConfirmPassword)" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-2">
                            Create Account
                        </button>

                    </EditForm>

                    <div class="text-center mt-4">
                        Already have an account?
                        <a href="/Account/Login">Login</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@code {

    [SupplyParameterFromForm(FormName = "register")]
    private RegisterInputModel Input { get; set; } = new();

    private string? ErrorMessage { get; set; }

    private async Task RegisterUser()
    {
        ErrorMessage = null;

        ApplicationUser? user = null;

        try
        {
            await using var transaction =
                await DbContext.Database.BeginTransactionAsync();

            user = new ApplicationUser
            {
                UserName = Input.Email.Trim(),
                Email = Input.Email.Trim(),
                EmailConfirmed = true
            };

            // Step 1: Create Identity account.
            var createResult =
                await UserManager.CreateAsync(user, Input.Password);

            if (!createResult.Succeeded)
            {
                await transaction.RollbackAsync();

                ErrorMessage = string.Join(" ",
                    createResult.Errors.Select(e => e.Description));

                return;
            }

            // Step 2: Assign PetOwner role.
            var roleResult =
                await UserManager.AddToRoleAsync(user, "PetOwner");

            if (!roleResult.Succeeded)
            {
                await transaction.RollbackAsync();

                ErrorMessage = string.Join(" ",
                    roleResult.Errors.Select(e => e.Description));

                return;
            }

            // Step 3: Create owner profile.
            var ownerProfile = new OwnerProfile
            {
                UserId = user.Id,
                FullName = Input.FullName.Trim(),
                CreatedAt = DateTime.UtcNow
            };

            DbContext.OwnerProfiles.Add(ownerProfile);

            await DbContext.SaveChangesAsync();

            // Step 4: Commit database transaction.
            await transaction.CommitAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Pet owner registration failed.");

            ErrorMessage =
                "Registration failed. Please try again. Check the application logs if the problem continues.";

            return;
        }

        try
        {
            // Step 5: Sign in the newly registered user.
            await SignInManager.SignInAsync(user!, isPersistent: false);

            Logger.LogInformation(
                "Pet owner account successfully registered and signed in.");

            // Step 6: Reload application with authentication cookie.
            Navigation.NavigateTo("/owner/dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Account created, but automatic sign-in failed.");

            ErrorMessage =
                "Your account was created, but automatic login failed. Please log in using your registered email and password.";
        }
    }

    private sealed class RegisterInputModel
    {
        [Required(ErrorMessage = "Full name is required.")]
        [StringLength(120)]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, MinimumLength = 6,
            ErrorMessage = "Password must contain at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password),
            ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
