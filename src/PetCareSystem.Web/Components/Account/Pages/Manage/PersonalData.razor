@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using PetCareSystem.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personal Data | Pawberry Animal Hospital</PageTitle>

<div class="container py-4 pawberry-profile">
    <div class="profile-welcome mb-4">
        <div>
            <span class="profile-eyebrow">ACCOUNT PRIVACY</span>
            <h2>My Personal Data 🛡️</h2>
            <p>Manage and protect the information associated with your account.</p>
        </div>
        <div class="profile-avatar">🔐</div>
    </div>

    <StatusMessage />

    <div class="profile-card mb-4">
        <div class="profile-card-heading">
            <div class="profile-heading-icon">📁</div>
            <div>
                <h4>Download Your Data</h4>
                <p>Keep a copy of your personal account information.</p>
            </div>
        </div>
        <p class="text-muted">You can download the personal data associated with your Pawberry account.</p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn profile-save-btn" type="submit">⬇ Download Personal Data</button>
        </form>
    </div>

    <div class="profile-card pawberry-delete-card">
        <div class="profile-card-heading">
            <div class="profile-heading-icon pawberry-delete-icon">⚠️</div>
            <div>
                <h4>Delete Your Account</h4>
                <p>Permanently remove your account and personal data.</p>
            </div>
        </div>
        <div class="pawberry-delete-warning">
            <strong>Important: This action cannot be undone.</strong>
            <p class="mb-0">Deleting your account permanently removes it. You will not be able to recover it.</p>
        </div>
        <a href="Account/Manage/DeletePersonalData" class="btn btn-danger mt-3">Continue to Account Deletion</a>
    </div>
</div>
@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
