    private async Task UpdateAppointmentStatusAsync(
        int appointmentId,
        string newStatus)
    {
        if (Veterinarian is null)
            return;

        if (newStatus != "Completed" && newStatus != "Cancelled")
            return;

        try
        {
            IsUpdating = true;
            ErrorMessage = null;
            Message = null;

            var appointment = await DbContext.Appointments
                .FirstOrDefaultAsync(a =>
                    a.AppointmentId == appointmentId &&
                    a.VeterinarianProfileId ==
                    Veterinarian.VeterinarianProfileId);

            if (appointment is null)
            {
                ErrorMessage = "Appointment not found.";
                return;
            }

            if (appointment.Status == "Completed" ||
                appointment.Status == "Cancelled" ||
                appointment.Status == "Canceled")
            {
                ErrorMessage = "This appointment has already been closed.";
                return;
            }

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var currentUser = await UserManager.GetUserAsync(
                authenticationState.User);

            var previousStatus = appointment.Status;

            appointment.Status = newStatus;
            appointment.UpdatedAt = DateTime.UtcNow;

            DbContext.AppointmentStatusHistories.Add(
                new AppointmentStatusHistory
                {
                    AppointmentId = appointment.AppointmentId,
                    PreviousStatus = previousStatus,
                    NewStatus = newStatus,
                    ChangedByUserId = currentUser?.Id,
                    ChangedAt = DateTime.UtcNow,
                    Remarks = "Updated by veterinarian."
                });

            await DbContext.SaveChangesAsync();

            Message = $"Appointment #{appointmentId} marked as {newStatus}.";

            await LoadAppointmentsAsync();

            SelectedAppointment = AllAppointments
                .FirstOrDefault(a => a.AppointmentId == appointmentId);

            if (SelectedAppointment is not null)
            {
                await ViewAppointmentAsync(SelectedAppointment);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Unable to update appointment: " + ex.Message;
        }
        finally
        {
            IsUpdating = false;
        }
    }

