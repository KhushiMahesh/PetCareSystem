    private string GetSelectedPetAge()
    {
        var pet = SelectedAppointment?.Pet;

        if (pet is null)
            return "Unavailable";

        var today = DateOnly.FromDateTime(DateTime.Today);

        int months;

        if (pet.DateOfBirth.HasValue)
        {
            var dob = pet.DateOfBirth.Value;

            if (dob > today)
                return "Invalid date of birth";

            months = (today.Year - dob.Year) * 12
                     + today.Month - dob.Month;

            if (today.Day < dob.Day)
                months--;
        }
        else if (pet.EstimatedAgeMonths.HasValue &&
                 pet.AgeEstimateRecordedAt.HasValue)
        {
            var recorded = pet.AgeEstimateRecordedAt.Value;

            months = pet.EstimatedAgeMonths.Value
                     + (today.Year - recorded.Year) * 12
                     + today.Month - recorded.Month;

            if (today.Day < recorded.Day)
                months--;
        }
        else
        {
            return "Not recorded";
        }

        months = Math.Max(0, months);

        return $"{months / 12} years, {months % 12} months"
               + (pet.IsAgeEstimated ? " (estimated)" : "");
    }
    private Task OnScheduledDoseChanged()
    {
        var schedule = AvailableVaccinationSchedules.FirstOrDefault(s =>
            s.PetVaccinationScheduleId == SelectedPetVaccinationScheduleId);

        if (schedule != null)
            SelectedVaccineId = schedule.Template.VaccineId;

        return Task.CompletedTask;
    }

    // Save a vaccination record
    private async Task SaveVaccinationAsync()
    {
        if (Veterinarian is null || SelectedAppointment is null)
            return;

        ErrorMessage = null;
        Message = null;

        if (string.IsNullOrWhiteSpace(DoseName))
        {
            ErrorMessage = "Please select the vaccination dose.";
            return;
        }

        if (SelectedVaccineId <= 0)
        {
            ErrorMessage = "Please select a vaccine.";
            return;
        }

        if (VaccinationDate > DateOnly.FromDateTime(DateTime.Today))
        {
            ErrorMessage = "Vaccination date cannot be in the future.";
            return;
        }

        if (NextDueDate.HasValue &&
            NextDueDate.Value < VaccinationDate)
        {
            ErrorMessage = "Next due date cannot be earlier than the vaccination date.";
            return;
        }

        try
        {
            IsSavingVaccination = true;

            // Verify that the appointment belongs to this veterinarian.

            var appointment = await DbContext.Appointments
                .FirstOrDefaultAsync(a =>
                    a.AppointmentId == SelectedAppointment.AppointmentId &&
                    a.VeterinarianProfileId ==
                    Veterinarian.VeterinarianProfileId);

            if (appointment is null)
            {
                ErrorMessage = "Appointment not found or access denied.";
                return;
            }

            if (appointment.Status == "Cancelled" ||
                appointment.Status == "Canceled")
            {
                ErrorMessage = "Cannot record a vaccination for a cancelled appointment.";
                return;
            }

            // Verify that the vaccine is active and belongs to this pet's species.

            var vaccine = await DbContext.Vaccines
                .FirstOrDefaultAsync(v =>
                    v.VaccineId == SelectedVaccineId &&
                    v.SpeciesId == SelectedAppointment.Pet.SpeciesId &&
                    v.IsActive);

            if (vaccine is null)
            {
                ErrorMessage = "Selected vaccine is invalid or unavailable for this pet.";
                return;
            }

            if (!string.Equals(
                vaccine.ReviewStatus,
                "Approved",
                StringComparison.OrdinalIgnoreCase))
            {
                ErrorMessage = "This vaccine has not been approved by the veterinarian and cannot be administered.";
                return;
            }
            PetVaccinationSchedule? selectedSchedule = null;

            if (SelectedPetVaccinationScheduleId > 0)
            {
                selectedSchedule = await DbContext.PetVaccinationSchedules
                    .Include(s => s.Template)
                    .FirstOrDefaultAsync(s =>
                        s.PetVaccinationScheduleId == SelectedPetVaccinationScheduleId &&
                        s.PetId == appointment.PetId &&
                        s.IsActive &&
                        s.VaccinationRecord == null &&
                        s.Template.IsActive &&
                        s.Template.IsApproved &&
                        s.Template.ApprovedByVeterinarianProfileId != null &&
                        s.Template.ApprovedAt != null &&
                        s.Template.VaccineId == vaccine.VaccineId);

                if (selectedSchedule is null)
                {
                    ErrorMessage = "Selected scheduled dose is unavailable or does not match the vaccine.";
                    return;
                }
            }

            var vaccinationRecord = new VaccinationRecord
            {
                PetId = appointment.PetId,
                VaccineId = vaccine.VaccineId,
                VeterinarianProfileId = Veterinarian.VeterinarianProfileId,
                PetVaccinationScheduleId = selectedSchedule?.PetVaccinationScheduleId,
                VaccinationDate = VaccinationDate,
                NextDueDate = NextDueDate,
                DoseName = DoseName,
                BatchNumber = string.IsNullOrWhiteSpace(VaccinationBatchNumber)
                    ? null
                    : VaccinationBatchNumber.Trim(),
                Notes = string.IsNullOrWhiteSpace(VaccinationNotes)
                    ? null
                    : VaccinationNotes.Trim()
            };

            DbContext.VaccinationRecords.Add(vaccinationRecord);

            await DbContext.SaveChangesAsync();

            // Refresh vaccination history

            SelectedPetVaccinationRecords = await DbContext.VaccinationRecords
                .AsNoTracking()
                .Include(v => v.Vaccine)
                .Include(v => v.Veterinarian)
                .Where(v => v.PetId == appointment.PetId)
                .OrderByDescending(v => v.VaccinationDate)
                .ToListAsync();

            // Reset vaccination form

            SelectedVaccineId = 0;
            SelectedPetVaccinationScheduleId = 0;
            VaccinationDate = DateOnly.FromDateTime(DateTime.Today);
            NextDueDate = null;
            DoseName = string.Empty;
            VaccinationBatchNumber = string.Empty;
            VaccinationNotes = string.Empty;

            Message = "Vaccination record saved successfully.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to save vaccination record.");
            ErrorMessage = "Unable to save vaccination record. Please try again.";
        }
        finally
        {
            IsSavingVaccination = false;
        }
    }

