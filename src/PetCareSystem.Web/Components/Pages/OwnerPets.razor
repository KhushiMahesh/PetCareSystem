@page "/owner/pets"

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PetOwner")]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PetCareSystem.Web.Data
@using PetCareSystem.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<OwnerPets> Logger
@inject PetCareSystem.Web.Services.VaccinationScheduleService VaccinationScheduleService

<PageTitle>My Pets | PetCareSystem</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Pets</h2>
            <p class="text-muted">Manage your pets and their information.</p>
        </div>

        <button class="btn btn-primary" @onclick="ShowAddForm">
            + Add New Pet
        </button>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <p>Loading your pets...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">
            @ErrorMessage
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success">
                @SuccessMessage
            </div>
        }

        @if (ShowForm)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">

                    <h4 class="mb-4">
                        @(IsEditing ? "Edit Pet Details" : "Register a New Pet")
                    </h4>

                    <EditForm Model="@PetForm" OnValidSubmit="@SavePet">

                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">Pet Name *</label>

                                <InputText class="form-control"
                                           @bind-Value="PetForm.PetName"
                                           placeholder="Enter pet name" />

                                <ValidationMessage For="@(() => PetForm.PetName)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Species *</label>

                                <InputSelect class="form-select"
                                             @bind-Value="PetForm.SpeciesId"
                                             @bind-Value:after="LoadBreedsForSelectedSpecies">

                                    <option value="0">Select species</option>

                                    @foreach (var species in SpeciesList)
                                    {
                                        <option value="@species.SpeciesId">
                                            @species.SpeciesName
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage For="@(() => PetForm.SpeciesId)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Breed</label>

                                <InputSelect class="form-select"
                                             @bind-Value="PetForm.BreedId"
                                             disabled="@(PetForm.SpeciesId == 0)">

                                    <option value="">Select breed (optional)</option>

                                    @foreach (var breed in BreedList)
                                    {
                                        <option value="@breed.BreedId">
                                            @breed.BreedName
                                        </option>
                                    }

                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Gender</label>

                                <InputSelect class="form-select"
                                             @bind-Value="PetForm.Gender">

                                    <option value="">Select gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Unknown">Unknown</option>

                                </InputSelect>
                            </div>

                            <div class="col-12">
                                <hr />
                                <h5>Age Information</h5>

                                <p class="text-muted small">
                                    Provide the exact date of birth if known.
                                    Otherwise, enter an estimated age or select
                                    that the age is unknown.
                                </p>

                                <label class="form-label">How do you know your pet's age?</label>

                                <InputSelect class="form-select"
                                             @bind-Value="PetForm.AgeInputMode">

                                    <option value="Exact">Exact date of birth</option>
                                    <option value="Estimated">Estimated age</option>
                                    <option value="Unknown">Age unknown</option>

                                </InputSelect>
                            </div>

                            @if (PetForm.AgeInputMode == "Exact")
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Date of Birth *</label>

                                    <InputDate class="form-control"
                                               @bind-Value="PetForm.DateOfBirth" />

                                    <ValidationMessage For="@(() => PetForm.DateOfBirth)" />
                                </div>
                            }
                            else if (PetForm.AgeInputMode == "Estimated")
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Estimated Years</label>

                                    <InputNumber class="form-control"
                                                 @bind-Value="PetForm.EstimatedAgeYears"
                                                 min="0"
                                                 max="100" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Additional Months</label>

                                    <InputNumber class="form-control"
                                                 @bind-Value="PetForm.EstimatedAgeAdditionalMonths"
                                                 min="0"
                                                 max="11" />

                                    <small class="text-muted">
                                        Enter a value between 0 and 11.
                                    </small>
                                </div>

                                <div class="col-12">
                                    <div class="alert alert-info">
                                        This age will be stored as an estimate.
                                        The veterinarian can verify it and adjust
                                        the vaccination plan if necessary.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="col-12">
                                    <div class="alert alert-secondary">
                                        No age information will be recorded.
                                        The veterinarian can assess your pet's
                                        age and establish an appropriate
                                        vaccination plan.
                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label">Weight (kg)</label>

                                <InputNumber class="form-control"
                                             @bind-Value="PetForm.Weight"
                                             step="0.01"
                                             min="0" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Colour</label>

                                <InputText class="form-control"
                                           @bind-Value="PetForm.Colour"
                                           placeholder="Enter pet colour" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Medical Notes</label>

                                <InputTextArea class="form-control"
                                               @bind-Value="PetForm.MedicalNotes"
                                               rows="3"
                                               placeholder="Enter medical history or important notes" />
                            </div>

                        </div>

                        @if (!string.IsNullOrEmpty(AgeValidationError))
                        {
                            <div class="alert alert-danger mt-3">
                                @AgeValidationError
                            </div>
                        }

                        <div class="mt-4 d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@IsSaving">

                                @(IsSaving ? "Saving..." :
                                    IsEditing ? "Update Pet" : "Save Pet")

                            </button>

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="CancelForm">
                                Cancel
                            </button>

                        </div>

                    </EditForm>

                </div>
            </div>
        }

        @if (Pets.Count == 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">

                    <h4>No Pets Registered Yet</h4>

                    <p class="text-muted">
                        Start by registering your first pet.
                    </p>

                    <button class="btn btn-primary" @onclick="ShowAddForm">
                        Register Your First Pet
                    </button>

                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <h5>Registered Pets (@Pets.Count)</h5>
            </div>

            <div class="row g-4">

                @foreach (var pet in Pets)
                {
                    <div class="col-md-6 col-lg-4" @key="pet.PetId">

                        <div class="card shadow-sm border-0 h-100">

                            <div class="card-body">

                                <h4>@pet.PetName</h4>

                                <p class="mb-2">
                                    <span class="badge bg-primary">
                                        PET-@pet.PetId.ToString("D3")
                                    </span>
                                </p>

                                <p class="text-muted mb-3">
                                    @pet.Species?.SpeciesName

                                    @if (pet.Breed != null)
                                    {
                                        <span> - @pet.Breed.BreedName</span>
                                    }
                                </p>

                                <hr />

                                <p>
                                    <strong>Gender:</strong>
                                    @(pet.Gender ?? "Not specified")
                                </p>

                                <p>
                                    <strong>Age:</strong>
                                    @GetPetAgeDisplay(pet)
                                </p>

                                @if (pet.IsAgeEstimated && pet.AgeEstimateRecordedAt.HasValue)
                                {
                                    <small class="text-muted">
                                        Estimated age recorded on
                                        @pet.AgeEstimateRecordedAt.Value.ToString("dd MMM yyyy")
                                    </small>
                                }

                                <p>
                                    <strong>Weight:</strong>
                                    @(pet.Weight.HasValue ? $"{pet.Weight.Value} kg" : "Not provided")
                                </p>

                                <p>
                                    <strong>Colour:</strong>
                                    @(pet.Colour ?? "Not provided")
                                </p>

                                <div class="d-flex gap-2 mt-3">

                                    <button class="btn btn-outline-primary btn-sm"
                                            @onclick="() => EditPet(pet.PetId)">
                                        Edit
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => DeletePet(pet.PetId)">
                                        Delete
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }

</div>

@code {

    private OwnerProfile? Owner;

    private List<Pet> Pets = new();

    private List<Species> SpeciesList = new();

    private List<Breed> BreedList = new();

    private PetInputModel PetForm = new();

    private bool IsLoading = true;
    private bool IsSaving;
    private bool ShowForm;
    private bool IsEditing;

    private int EditingPetId;

    private string? ErrorMessage;
    private string? SuccessMessage;
    private string? AgeValidationError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = await UserManager.GetUserAsync(authState.User);

            if (user == null)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            Owner = await DbContext.OwnerProfiles
                .FirstOrDefaultAsync(o => o.UserId == user.Id);

            if (Owner == null)
            {
                ErrorMessage = "Your owner profile could not be found.";
                return;
            }

            await LoadSpecies();
            await LoadPets();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading owner pets.");
            ErrorMessage = "Unable to load your pets. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadSpecies()
    {
        SpeciesList = await DbContext.Species
            .Where(s => s.IsActive)
            .OrderBy(s => s.SpeciesName)
            .ToListAsync();
    }

    private async Task LoadPets()
    {
        if (Owner == null)
            return;

        Pets = await DbContext.Pets
            .Include(p => p.Species)
            .Include(p => p.Breed)
            .Where(p => p.OwnerProfileId == Owner.OwnerProfileId)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();
    }

    private async Task LoadBreedsForSelectedSpecies()
    {
        PetForm.BreedId = null;

        if (PetForm.SpeciesId <= 0)
        {
            BreedList.Clear();
            return;
        }

        BreedList = await DbContext.Breeds
            .Where(b => b.SpeciesId == PetForm.SpeciesId && b.IsActive)
            .OrderBy(b => b.BreedName)
            .ToListAsync();
    }

    private void ShowAddForm()
    {
        PetForm = new PetInputModel();

        BreedList.Clear();

        IsEditing = false;
        EditingPetId = 0;

        ErrorMessage = null;
        SuccessMessage = null;
        AgeValidationError = null;

        ShowForm = true;
    }

    private async Task EditPet(int petId)
    {
        if (Owner == null)
            return;

        var pet = await DbContext.Pets
            .FirstOrDefaultAsync(p =>
                p.PetId == petId &&
                p.OwnerProfileId == Owner.OwnerProfileId);

        if (pet == null)
        {
            ErrorMessage = "Pet not found.";
            return;
        }

        PetForm = new PetInputModel
        {
            PetName = pet.PetName,
            SpeciesId = pet.SpeciesId,
            BreedId = pet.BreedId,
            Gender = pet.Gender,
            DateOfBirth = pet.DateOfBirth,
            Weight = pet.Weight,
            Colour = pet.Colour,
            MedicalNotes = pet.MedicalNotes
        };

        if (pet.DateOfBirth.HasValue)
        {
            PetForm.AgeInputMode = "Exact";
        }
        else if (pet.IsAgeEstimated && pet.EstimatedAgeMonths.HasValue)
        {
            PetForm.AgeInputMode = "Estimated";
            PetForm.EstimatedAgeYears = pet.EstimatedAgeMonths.Value / 12;
            PetForm.EstimatedAgeAdditionalMonths = pet.EstimatedAgeMonths.Value % 12;
        }
        else
        {
            PetForm.AgeInputMode = "Unknown";
        }

        EditingPetId = pet.PetId;

        IsEditing = true;
        ShowForm = true;

        ErrorMessage = null;
        SuccessMessage = null;
        AgeValidationError = null;

        await LoadBreedsForEditing();
    }

    private async Task LoadBreedsForEditing()
    {
        if (PetForm.SpeciesId <= 0)
            return;

        BreedList = await DbContext.Breeds
            .Where(b =>
                b.SpeciesId == PetForm.SpeciesId &&
                b.IsActive)
            .OrderBy(b => b.BreedName)
            .ToListAsync();
    }

    private async Task SavePet()
    {
        if (Owner == null || IsSaving)
            return;

        ErrorMessage = null;
        SuccessMessage = null;
        AgeValidationError = null;

        IsSaving = true;

        try
        {
            var speciesExists = await DbContext.Species
                .AnyAsync(s =>
                    s.SpeciesId == PetForm.SpeciesId &&
                    s.IsActive);

            if (!speciesExists)
            {
                ErrorMessage = "Please select a valid species.";
                return;
            }

            if (PetForm.BreedId.HasValue)
            {
                var breedExists = await DbContext.Breeds
                    .AnyAsync(b =>
                        b.BreedId == PetForm.BreedId.Value &&
                        b.SpeciesId == PetForm.SpeciesId &&
                        b.IsActive);

                if (!breedExists)
                {
                    ErrorMessage = "Please select a valid breed.";
                    return;
                }
            }

            if (PetForm.AgeInputMode == "Exact")
            {
                if (!PetForm.DateOfBirth.HasValue)
                {
                    AgeValidationError = "Please enter the date of birth.";
                    return;
                }

                if (PetForm.DateOfBirth.Value > DateOnly.FromDateTime(DateTime.Today))
                {
                    AgeValidationError = "Date of birth cannot be in the future.";
                    return;
                }
            }
            else if (PetForm.AgeInputMode == "Estimated")
            {
                if (!PetForm.EstimatedAgeYears.HasValue &&
                    !PetForm.EstimatedAgeAdditionalMonths.HasValue)
                {
                    AgeValidationError = "Please enter the estimated age.";
                    return;
                }

                if (PetForm.EstimatedAgeYears < 0 ||
                    PetForm.EstimatedAgeYears > 100)
                {
                    AgeValidationError = "Estimated years must be between 0 and 100.";
                    return;
                }

                if (PetForm.EstimatedAgeAdditionalMonths < 0 ||
                    PetForm.EstimatedAgeAdditionalMonths > 11)
                {
                    AgeValidationError = "Additional months must be between 0 and 11.";
                    return;
                }

                var totalMonths =
                    (PetForm.EstimatedAgeYears ?? 0) * 12 +
                    (PetForm.EstimatedAgeAdditionalMonths ?? 0);

                if (totalMonths <= 0)
                {
                    AgeValidationError = "Estimated age must be greater than zero.";
                    return;
                }
            }
            else if (PetForm.AgeInputMode != "Unknown")
            {
                AgeValidationError = "Please select a valid age option.";
                return;
            }

            if (PetForm.Weight.HasValue && PetForm.Weight.Value <= 0)
            {
                ErrorMessage = "Weight must be greater than zero.";
                return;
            }

            Pet? newlyCreatedPet = null;

            if (IsEditing)
            {
                var pet = await DbContext.Pets
                    .FirstOrDefaultAsync(p =>
                        p.PetId == EditingPetId &&
                        p.OwnerProfileId == Owner.OwnerProfileId);

                if (pet == null)
                {
                    ErrorMessage = "Pet not found.";
                    return;
                }

                UpdatePetDetails(pet);
            }
            else
            {
                var pet = new Pet
                {
                    OwnerProfileId = Owner.OwnerProfileId,
                    CreatedAt = DateTime.UtcNow
                };

                UpdatePetDetails(pet);

                DbContext.Pets.Add(pet);

                newlyCreatedPet = pet;
            }

            await DbContext.SaveChangesAsync();

            var savedPetId = newlyCreatedPet?.PetId ?? EditingPetId;

            var generatedScheduleCount = 0;

            try
            {
                generatedScheduleCount =
                    await VaccinationScheduleService.GenerateForPetAsync(
                        savedPetId);
            }
            catch (Exception scheduleException)
            {
                Logger.LogError(
                    scheduleException,
                    "Vaccination schedule synchronization failed for pet {PetId}.",
                    savedPetId);
            }

            Logger.LogInformation(
                "Synchronized vaccination schedules for pet {PetId}. New schedules: {ScheduleCount}.",
                savedPetId,
                generatedScheduleCount);

            if (newlyCreatedPet != null)
            {
                SuccessMessage =
                    $"Pet registered successfully! Your Pet ID is PET-{savedPetId:D3}.";
            }
            else
            {
                SuccessMessage =
                    "Pet details updated successfully. Vaccination schedules have been synchronized.";
            }
            ShowForm = false;

            await LoadPets();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving pet information.");
            ErrorMessage = "Unable to save pet information. Please try again.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void UpdatePetDetails(Pet pet)
    {
        pet.PetName = PetForm.PetName.Trim();
        pet.SpeciesId = PetForm.SpeciesId;
        pet.BreedId = PetForm.BreedId;
        pet.Gender = PetForm.Gender;

        if (PetForm.AgeInputMode == "Exact")
        {
            pet.DateOfBirth = PetForm.DateOfBirth;
            pet.EstimatedAgeMonths = null;
            pet.AgeEstimateRecordedAt = null;
            pet.IsAgeEstimated = false;
        }
        else if (PetForm.AgeInputMode == "Estimated")
        {
            pet.DateOfBirth = null;

            pet.EstimatedAgeMonths =
                (PetForm.EstimatedAgeYears ?? 0) * 12 +
                (PetForm.EstimatedAgeAdditionalMonths ?? 0);

            pet.AgeEstimateRecordedAt = DateOnly.FromDateTime(DateTime.Today);
            pet.IsAgeEstimated = true;
        }
        else
        {
            pet.DateOfBirth = null;
            pet.EstimatedAgeMonths = null;
            pet.AgeEstimateRecordedAt = null;
            pet.IsAgeEstimated = false;
        }

        pet.Weight = PetForm.Weight;
        pet.Colour = PetForm.Colour;
        pet.MedicalNotes = PetForm.MedicalNotes;
    }

    private string GetPetAgeDisplay(Pet pet)
    {
        if (pet.DateOfBirth.HasValue)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var dob = pet.DateOfBirth.Value;

            int years = today.Year - dob.Year;
            int months = today.Month - dob.Month;

            if (today.Day < dob.Day)
                months--;

            if (months < 0)
            {
                years--;
                months += 12;
            }

            if (years < 0)
                return "Invalid date";

            if (years == 0 && months == 0)
                return "Less than 1 month";

            if (years == 0)
                return $"{months} month(s)";

            if (months == 0)
                return $"{years} year(s)";

            return $"{years} year(s), {months} month(s)";
        }

        if (pet.IsAgeEstimated && pet.EstimatedAgeMonths.HasValue)
        {
            int years = pet.EstimatedAgeMonths.Value / 12;
            int months = pet.EstimatedAgeMonths.Value % 12;

            string display = years > 0
                ? $"{years} year(s)"
                : "";

            if (months > 0)
            {
                display += years > 0
                    ? $", {months} month(s)"
                    : $"{months} month(s)";
            }

            return $"{display} (Estimated)";
        }

        return "Unknown";
    }

    private async Task DeletePet(int petId)
    {
        if (Owner == null)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this pet?");

        if (!confirmed)
            return;

        try
        {
            var pet = await DbContext.Pets
                .FirstOrDefaultAsync(p =>
                    p.PetId == petId &&
                    p.OwnerProfileId == Owner.OwnerProfileId);

            if (pet == null)
            {
                ErrorMessage = "Pet not found.";
                return;
            }

            DbContext.Pets.Remove(pet);

            await DbContext.SaveChangesAsync();

            SuccessMessage = "Pet deleted successfully.";

            ErrorMessage = null;

            await LoadPets();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting pet.");

            ErrorMessage =
                "Unable to delete this pet. It may have related medical or appointment records.";
        }
    }

    private void CancelForm()
    {
        ShowForm = false;
        ErrorMessage = null;
        AgeValidationError = null;
    }

    private sealed class PetInputModel
    {
        [Required(ErrorMessage = "Pet name is required.")]
        [StringLength(100)]
        public string PetName { get; set; } = string.Empty;

        [Range(1, int.MaxValue, ErrorMessage = "Please select a species.")]
        public int SpeciesId { get; set; }

        public int? BreedId { get; set; }

        public string? Gender { get; set; }

        public string AgeInputMode { get; set; } = "Exact";

        public DateOnly? DateOfBirth { get; set; }

        public int? EstimatedAgeYears { get; set; }

        public int? EstimatedAgeAdditionalMonths { get; set; }

        public decimal? Weight { get; set; }

        public string? Colour { get; set; }

        public string? MedicalNotes { get; set; }
    }
}
