@page "/owner/vaccinations"

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "PetOwner")]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PetCareSystem.Web.Data
@using PetCareSystem.Web.Models

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Vaccinations | Pawberry Animal Hospital</PageTitle>

<div class="container py-4 pawberry-owner-page">

    <div class="mb-4">
        <h2>My Pets' Vaccinations</h2>
        <p class="text-muted">
            Track scheduled vaccinations, upcoming doses and vaccination history
            recorded by your veterinarians.
        </p>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <p>Loading vaccination information...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else
    {
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Pending</h6>
                        <h3>@PendingCount</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Upcoming</h6>
                        <h3 class="text-primary">@UpcomingCount</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Overdue</h6>
                        <h3 class="text-danger">@OverdueCount</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Completed</h6>
                        <h3 class="text-success">@CompletedCount</h3>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">Vaccination Schedule</h5>
            </div>

            <div class="card-body">

                @foreach (var pet in Pets.Where(p => !Schedules.Any(s => s.PetId == p.PetId)))
                {
                    <div class="alert alert-warning mb-3">
                        <h6 class="mb-1">Vaccination Information Unavailable</h6>
                        <strong>@pet.PetName</strong> (@pet.Species.SpeciesName)
                        <p class="mb-0">
                            We currently don't have verified vaccination information for this species.
                            Please book a consultation with a veterinarian for a personalised
                            vaccination assessment and recommendations.
                        </p>
                    </div>
                }

                @if (Schedules.Count == 0)
                {
                    <div class="text-center py-4">
                        <h6>No Vaccination Schedule Available</h6>
                        <p class="text-muted mb-0">
                            No veterinarian-approved vaccination schedule
                            is currently available for your pets.
                            Please consult your veterinarian for an
                            appropriate vaccination plan.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Pet</th>
                                    <th>Vaccine</th>
                                    <th>Dose</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Administration</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var schedule in Schedules)
                                {
                                    var status = GetStatus(schedule);

                                    <tr>
                                        <td>
                                            <strong>@schedule.Pet.PetName</strong>
                                            <div class="small text-muted">
                                                @schedule.Pet.Species.SpeciesName
                                            </div>
                                        </td>

                                        <td>
                                            @schedule.Template.Vaccine.VaccineName
                                        </td>

                                        <td>
                                            @schedule.Template.DoseName
                                        </td>

                                        <td>
                                            @schedule.DueDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @if (status == "Completed")
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else if (status == "Overdue")
                                            {
                                                <span class="badge bg-danger">Overdue</span>
                                            }
                                            else if (status == "Due Today")
                                            {
                                                <span class="badge bg-warning text-dark">Due Today</span>
                                            }
                                            else if (status == "Upcoming")
                                            {
                                                <span class="badge bg-primary">Upcoming</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pending</span>
                                            }
                                        </td>

                                        <td>
                                            @if (schedule.VaccinationRecord != null)
                                            {
                                                <div class="text-success">
                                                    Administered:
                                                    @schedule.VaccinationRecord.VaccinationDate.ToString("dd MMM yyyy")
                                                </div>

                                                <div class="small text-muted">
                                                    @schedule.VaccinationRecord.Veterinarian.FullName
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not administered</span>
                                            }
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Next Dose Reminders</h5>
            </div>
            <div class="card-body">
                @if (!NextDoseReminders.Any())
                {
                    <p class="text-muted text-center mb-0">
                        No additional next-dose reminders are available.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Pet</th>
                                    <th>Vaccine</th>
                                    <th>Previous Dose</th>
                                    <th>Next Due Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reminder in NextDoseReminders.OrderBy(r => r.NextDueDate))
                                {
                                    var reminderStatus = GetReminderStatus(reminder);
                                    <tr>
                                        <td>@reminder.Pet.PetName</td>
                                        <td>@reminder.Vaccine.VaccineName</td>
                                        <td>@(reminder.DoseName ?? "Not recorded")</td>
                                        <td>@reminder.NextDueDate?.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (reminderStatus == "Overdue")
                                            {
                                                <span class="badge bg-danger">Overdue</span>
                                            }
                                            else if (reminderStatus == "Due Today")
                                            {
                                                <span class="badge bg-warning text-dark">Due Today</span>
                                            }
                                            else if (reminderStatus == "Upcoming")
                                            {
                                                <span class="badge bg-primary">Upcoming</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="card shadow-sm">

            <div class="card-header">
                <h5 class="mb-0">Vaccination History</h5>
            </div>

            <div class="card-body">

                @if (HistoricalRecords.Count == 0)
                {
                    <p class="text-muted text-center py-3 mb-0">
                        No additional historical vaccination records available.
                    </p>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Pet</th>
                                    <th>Vaccine</th>
                                    <th>Dose</th>
                                    <th>Vaccination Date</th>
                                    <th>Next Due Date</th>
                                    <th>Veterinarian</th>
                                    <th>Batch Number</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var record in HistoricalRecords)
                                {
                                    <tr>
                                        <td>
                                            <strong>@record.Pet.PetName</strong>
                                            <div class="small text-muted">
                                                @record.Pet.Species.SpeciesName
                                            </div>
                                        </td>

                                        <td>@record.Vaccine.VaccineName</td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(record.DoseName) ? "Not recorded" : record.DoseName)
                                        </td>

                                        <td>
                                            @record.VaccinationDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @(record.NextDueDate?.ToString("dd MMM yyyy") ?? "Not specified")
                                        </td>

                                        <td>
                                            @record.Veterinarian.FullName
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(record.BatchNumber)
                                                ? "Not specified"
                                                : record.BatchNumber)
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>
        </div>

        <div class="alert alert-info mt-4">
            <strong>Important:</strong>
            A vaccination is marked as completed only after a veterinarian
            records its actual administration. Pending and overdue statuses
            are based on the approved schedule and due date.
            Please consult your veterinarian before making vaccination decisions.
        </div>
    }

</div>

@code {

    private List<Pet> Pets = new();

    private List<PetVaccinationSchedule> Schedules = new();

    private List<VaccinationRecord> HistoricalRecords = new();

    private IEnumerable<VaccinationRecord> NextDoseReminders =>
        HistoricalRecords.Where(r =>
            r.NextDueDate.HasValue &&
            !Schedules.Any(s =>
                s.PetId == r.PetId &&
                s.Template.VaccineId == r.VaccineId &&
                s.DueDate == r.NextDueDate.Value));

    private bool IsLoading = true;

    private string? ErrorMessage;

    private readonly TimeZoneInfo IndiaTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows()
                ? "India Standard Time"
                : "Asia/Kolkata");

    private DateOnly Today =>
        DateOnly.FromDateTime(
            TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                IndiaTimeZone));

    private int PendingCount =>
        Schedules.Count(s => GetStatus(s) == "Pending") + NextDoseReminders.Count(r => GetReminderStatus(r) == "Pending");

    private int UpcomingCount =>
        Schedules.Count(s => GetStatus(s) == "Upcoming" || GetStatus(s) == "Due Today") + NextDoseReminders.Count(r => GetReminderStatus(r) == "Upcoming" || GetReminderStatus(r) == "Due Today");

    private int OverdueCount =>
        Schedules.Count(s => GetStatus(s) == "Overdue") + NextDoseReminders.Count(r => GetReminderStatus(r) == "Overdue");

    private int CompletedCount =>
        Schedules.Count(s => GetStatus(s) == "Completed") + HistoricalRecords.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = await UserManager.GetUserAsync(
                authenticationState.User);

            if (user is null)
            {
                Navigation.NavigateTo("/Account/Login");
                return;
            }

            var owner = await DbContext.OwnerProfiles
                .AsNoTracking()
                .FirstOrDefaultAsync(o => o.UserId == user.Id);

            if (owner is null)
            {
                ErrorMessage = "Your owner profile could not be found.";
                return;
            }

            Pets = await DbContext.Pets
                .AsNoTracking()
                .Include(p => p.Species)
                .Where(p => p.OwnerProfileId == owner.OwnerProfileId)
                .OrderBy(p => p.PetName)
                .ToListAsync();

            Schedules = await DbContext.PetVaccinationSchedules
                .AsNoTracking()
                .Include(s => s.Pet)
                    .ThenInclude(p => p.Species)
                .Include(s => s.Template)
                    .ThenInclude(t => t.Vaccine)
                .Include(s => s.VaccinationRecord)
                    .ThenInclude(r => r!.Veterinarian)
                .Where(s =>
                    s.Pet.OwnerProfileId == owner.OwnerProfileId &&
                    s.IsActive &&
                    s.Template.IsActive &&
                    s.Template.IsApproved &&
                    s.Template.Vaccine.IsActive &&
                    s.Template.Vaccine.ReviewStatus == "Approved" &&
                    s.Template.SpeciesId == s.Pet.SpeciesId &&
                    s.Template.Vaccine.SpeciesId == s.Pet.SpeciesId)
                .OrderBy(s => s.DueDate)
                .ToListAsync();

            // Historical records without a schedule link are displayed
            // separately to avoid duplicating scheduled completed doses.
            HistoricalRecords = await DbContext.VaccinationRecords
                .AsNoTracking()
                .Include(r => r.Pet)
                    .ThenInclude(p => p.Species)
                .Include(r => r.Vaccine)
                .Include(r => r.Veterinarian)
                .Where(r =>
                    r.Pet.OwnerProfileId == owner.OwnerProfileId &&
                    r.PetVaccinationScheduleId == null)
                .OrderByDescending(r => r.VaccinationDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Unable to load vaccination information. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetReminderStatus(VaccinationRecord record)
    {
        if (!record.NextDueDate.HasValue)
            return "Pending";

        if (record.NextDueDate.Value < Today)
            return "Overdue";

        if (record.NextDueDate.Value == Today)
            return "Due Today";

        if (record.NextDueDate.Value <= Today.AddDays(30))
            return "Upcoming";

        return "Pending";
    }

    private string GetStatus(PetVaccinationSchedule schedule)
    {
        if (schedule.VaccinationRecord != null)
            return "Completed";

        if (schedule.DueDate < Today)
            return "Overdue";

        if (schedule.DueDate == Today)
            return "Due Today";

        if (schedule.DueDate <= Today.AddDays(30))
            return "Upcoming";

        return "Pending";
    }
}


